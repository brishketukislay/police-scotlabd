.wheel-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28px 10px 10px;
}

.wheel-pointer {
  position: absolute;
  z-index: 5;
  top: 8px;
  font-size: 30px;
  line-height: 1;
  filter: drop-shadow(0 4px 8px rgba(0,0,0,.45));
}

.wheel {
  position: relative;
  width: 240px;
  height: 240px;
  border-radius: 50%;
  border: 8px solid rgba(255,255,255,.12);
  background:
    conic-gradient(
      from -30deg,
      #19d3ff 0deg 60deg,
      #713cff 60deg 120deg,
      #f5c542 120deg 180deg,
      #19d3ff 180deg 240deg,
      #713cff 240deg 300deg,
      #f5c542 300deg 360deg
    );
  box-shadow:
    0 0 0 2px rgba(255,255,255,.06),
    0 18px 50px rgba(0,0,0,.45);
  transform-origin: center;
  will-change: transform;
}

.wheel::after {
  content: "";
  position: absolute;
  inset: 10px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,.2);
  pointer-events: none;
}

.wheel span {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 80px;
  margin-left: -40px;
  margin-top: -10px;
  text-align: center;
  font-weight: 900;
  font-size: 14px;
  color: #fff;
  text-shadow: 0 2px 5px rgba(0,0,0,.55);
}

.wheel-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 76px;
  height: 76px;
  margin-left: -38px;
  margin-top: -38px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111827;
  border: 4px solid rgba(255,255,255,.18);
  color: #fff;
  font-weight: 900;
  font-size: 16px;
  box-shadow: 0 6px 18px rgba(0,0,0,.4);
}

.wheel-wrap{
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:18px 8px 8px;
  position:relative;
}

.wheel-pointer{
  position:absolute;
  top:8px;
  z-index:5;
  font-size:30px;
  line-height:1;
}

.wheel{
  width:230px;
  height:230px;
  border-radius:50%;
  position:relative;
  margin:20px 0 18px;
  background:
    conic-gradient(
      from 0deg,
      #6d5dfc 0deg 60deg,
      #19d3ff 60deg 120deg,
      #b8f35a 120deg 180deg,
      #f5c451 180deg 240deg,
      #9b6cff 240deg 300deg,
      #27e0a3 300deg 360deg
    );
  border:8px solid #101722;
  box-shadow:0 0 0 2px rgba(255,255,255,.08),0 18px 45px rgba(0,0,0,.35);
  will-change:transform;
}

.wheel span{
  position:absolute;
  left:50%;
  top:50%;
  width:90px;
  margin-left:-45px;
  margin-top:-10px;
  text-align:center;
  font-size:12px;
  font-weight:800;
  letter-spacing:.02em;
  color:#071018;
  pointer-events:none;
}

.wheel-core{
  position:absolute;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  width:72px;
  height:72px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  background:#101722;
  border:3px solid rgba(255,255,255,.15);
  color:#fff;
  font-size:15px;
  font-weight:900;
  box-shadow:0 5px 20px rgba(0,0,0,.35);
}

.wheel-title{
  margin:2px 0 4px;
  text-align:center;
}

.wheel-wrap .modal-note{
  text-align:center;
  max-width:330px;
}

